# Copy to local.mk (which git ignores) and fill in.  Used by `make mas' and
# `make testflight'; nothing else needs it.
#
# MAS_IDENTITY = Apple Distribution: Your Name (TEAMID)
# MAS_INSTALLER_IDENTITY = 3rd Party Mac Developer Installer: Your Name (TEAMID)
# MAS_PROFILE = $(HOME)/path/to/UTC_Status_Mac_App_Store.provisionprofile
#
# An App Store Connect API key; altool reads its .p8 from
# ~/.appstoreconnect/private_keys/.
# ASC_KEY_ID = XXXXXXXXXX
# ASC_ISSUER_ID = xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
